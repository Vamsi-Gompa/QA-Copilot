{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "backend",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8001"
            ],
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "name": "frontend",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5200",
            "cwd": "${workspaceFolder}/frontend"
        }
    ]
}